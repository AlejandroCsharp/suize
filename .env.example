# Variables de entorno de Suize. Copia este archivo a .env y ajusta los valores.
#
# Suize no lee .env por sí mismo (solo usa la stdlib). Opciones:
#   - scripts/run.sh lo carga automáticamente si existe.
#   - O expórtalo a mano:  set -a; source .env; set +a
#
# Las variables vacías se ignoran. Precedencia (menor → mayor):
#   default.toml del paquete → archivo de config del usuario → estas variables.

# Archivo TOML propio (por defecto: ~/.config/suize/config.toml).
SUIZE_CONFIG=

# Objetivo que se propone por defecto al escanear.
SUIZE_DEFAULT_TARGET=127.0.0.1

# Perfil de escaneo: fast | standard | full
SUIZE_SCAN_PROFILE=standard

# Tiempo máximo de un escaneo de Nmap, en segundos.
SUIZE_SCAN_TIMEOUT=600

# Líneas máximas que se piden a journalctl.
SUIZE_LOG_LINES=200

# Tiempo máximo de una consulta a journalctl, en segundos.
SUIZE_JOURNAL_TIMEOUT=60

# Preset temporal por defecto (15m, 1h, 6h, 24h, 7d, today, yesterday...).
SUIZE_TIME_PRESET=1h
